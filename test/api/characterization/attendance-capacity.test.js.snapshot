credentials: group 5 POC (rafael.t.mendoza, role poc)
request body:
  {
    "id": 1,
    "sprintName": "Sprint 2",
    "eid": "rafael.t.mendoza",
    "cadence": 3,
    "admin": 1,
    "holiday": 0
  }

status: 200
content-type: application/json; charset=utf-8
access-control-allow-origin: *
x-powered-by: Express
response body:
  {
    "id": 1,
    "sprintName": "Sprint 2",
    "eid": "rafael.t.mendoza",
    "cadence": 3,
    "admin": 1,
    "holiday": 0
  }

stored data:
  ~ /capacity-entries[id=1]/cadence: 4 → 3
  ~ /capacity-entries[id=1]/admin: 0 → 1
data files: unchanged

outbound calls: none

`;

